# =====================================================================
# TERRAI — Variables de entorno de ejemplo
# Copia este archivo a ".env" y completa con tus propias claves.
# NUNCA subas tu archivo ".env" real al repositorio.
# =====================================================================

# --- Base de datos (PostgreSQL + PostGIS) ---
POSTGRES_USER=terrai
POSTGRES_PASSWORD=change_me
POSTGRES_DB=terrai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://terrai:change_me@db:5432/terrai

# --- Seguridad / Auth ---
SECRET_KEY=change_me_to_a_random_64_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Copernicus Data Space Ecosystem / Sentinel Hub ---
# Regístrate gratis en https://dataspace.copernicus.eu/
# Crea credenciales OAuth en el Dashboard de Sentinel Hub (dentro de CDSE)
# Cuota gratuita: 10,000 processing units / 10,000 requests / 12TB transfer por mes
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_HUB_BASE_URL=https://sh.dataspace.copernicus.eu

# --- USGS (Landsat) opcional, requiere cuenta EROS ---
USGS_EROS_USERNAME=
USGS_EROS_PASSWORD=

# --- LLM para la capa ECO-INTELLIGENCE / redacción de informes ---
# Cualquier proveedor compatible con API de chat (Anthropic, OpenAI, etc.)
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# --- Almacenamiento de archivos (S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=terrai
S3_SECRET_KEY=change_me
S3_BUCKET_NAME=terrai-storage
S3_REGION=us-east-1

# --- Geocodificación para búsqueda de ubicaciones en el mapa ---
# Nominatim (OpenStreetMap) no requiere clave, pero respeta su política de uso justo.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
